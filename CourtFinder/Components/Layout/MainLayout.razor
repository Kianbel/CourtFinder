@inherits LayoutComponentBase

<header class="site-header">
    <div class="container nav">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="3" />
                    <path d="M12 5v14" />
                    <circle cx="12" cy="12" r="2.5" />
                </svg>
            </span>
            <span>CourtFinder</span>
        </a>

        <nav class="nav-links" aria-label="Main">
            <NavLink href="courts">Explore</NavLink>
            <NavLink href="owner/courts/new">List your court</NavLink>
        </nav>

        <div class="nav-actions">
            <UserMenu />
        </div>
    </div>
</header>

<main>
    @Body
</main>

<footer class="site-footer">
    <div class="container footer-inner">
        <span class="brand-small">CourtFinder</span>
        <span class="muted">Find a court, check the reviews, book and play.</span>
    </div>
</footer>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Inject] private AuthService Auth { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Auth.InitializeAsync();
    }
}